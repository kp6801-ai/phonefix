{
  "name": "phonefix",
  "version": "0.1.0",
  "private": true,
  "description": "One command. Every phone. Cross-agent skill that audits, auto-fixes and re-verifies any web app on real phone viewports.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "capture:before": "node skills/phonefix/scripts/capture.mjs --dir examples/laptop-only --label before --out examples/report",
    "capture:after": "node skills/phonefix/scripts/capture.mjs --dir examples/fixed --label after --out examples/report",
    "report": "node skills/phonefix/scripts/report.mjs --out examples/report",
    "adapters:check": "node adapters/sync.mjs --check",
    "adapters:sync": "node adapters/sync.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
